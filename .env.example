# Council — Environment Variables
# Copy this file to .env and customize. All entries are optional.
# Council delegates authentication to the individual CLIs (claude, codex, opencode).
# You must install and authenticate those CLIs separately before using Council.

# ---- Providers ----
# Valid examples: claude_cli, codex_cli, opencode, openrouter, deepseek_api, custom
# COUNCIL_PROVIDER_CLAUDE=claude_cli
# COUNCIL_PROVIDER_CODEX=codex_cli
# COUNCIL_PROVIDER_DEEPSEEK=opencode
# COUNCIL_PROVIDER_HERMES=hermes_api

# ---- Mention names ----
# Configure these in the web Config panel if you want @sonnet, @gpt, @flash, etc.
# The internal slots remain claude/codex/deepseek for storage and compatibility.

# ---- Binary paths (overrides config.toml) ----
# If your CLIs are not on PATH, specify absolute paths here:
# COUNCIL_BINARY_CLAUDE=C:\tools\claude\claude.exe
# COUNCIL_BINARY_CODEX=C:\tools\codex\codex.exe
# COUNCIL_BINARY_OPENCODE=C:\tools\opencode\opencode.exe

# ---- Model IDs (overrides config.toml) ----
# COUNCIL_MODEL_CLAUDE=claude-opus-4-7
# COUNCIL_MODEL_CODEX=gpt-5.5
# COUNCIL_MODEL_DEEPSEEK_PRO=deepseek/deepseek-v4-pro
# COUNCIL_MODEL_DEEPSEEK_FLASH=deepseek/deepseek-v4-flash
# COUNCIL_MODEL_HERMES=hermes-agent

# ---- API keys ----
# The web UI writes global keys to .council/secrets.json and session keys to that
# session's state.json. Environment variables are still useful for CLI auth.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_FLASH_API_KEY=sk-...
# Required only when Hermes uses X-Hermes-Session-Key session isolation.
# Must match API_SERVER_KEY in the Hermes .env.
# COUNCIL_HERMES_API_KEY=...

# ---- Hermes/API bridge ----
# The Hermes slot can point at Hermes or another OpenAI-compatible gateway.
# COUNCIL_HERMES_BASE_URL=http://127.0.0.1:8642/v1
# COUNCIL_HERMES_SESSION_KEY=
# Leave blank to disable the extra session header for non-Hermes gateways.
# COUNCIL_HERMES_SESSION_HEADER=X-Hermes-Session-Key

# For the Hermes gateway itself, put these in Hermes' own .env:
# API_SERVER_ENABLED=true
# API_SERVER_HOST=127.0.0.1
# API_SERVER_PORT=8642
# API_SERVER_KEY=...

# ---- Server ----
# COUNCIL_PORT=6767
# COUNCIL_HOST=0.0.0.0
